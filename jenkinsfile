pipeline {
  agent {
    docker {
        image 'node:18'
    }
  }
  stages {
    stage('Install') {
      steps {
        sh 'npm install'
      }
    }
    stage('Test') {
      steps {
        sh 'npm test'
      }
    }
    stage('Report') {
      steps {
        junit 'coverage/junit.xml'  // ถ้ามีแปลงผลลัพธ์ Jest เป็น JUnit
      }
    }
  }
}