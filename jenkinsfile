pipeline {
  agent any
  tools {
    nodejs 'Node 18'
  }
  stages {
    stage('Install') {
      steps {
        sh 'npm install'
      }
    }
    stage('Run') {
      steps {
        sh 'npm run dev'
      }
    }
    stage('Test') {
      steps {
        sh 'npm test'
      }
    }
    stage('Report') {
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          junit 'coverage/junit.xml'
        }
      }
    }
  }
}
