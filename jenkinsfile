pipeline {
  agent { label 'build-server' }
  environment {
    APP_NAME = "workflow testing"
    IMAGE_NAME = "workflow"
  }
  stages {
    stage("Build Image") {
      steps {
        sh "echo ${APP_NAME}"
        sh "docker version"
        sh "docker build -t ${IMAGE_NAME} ."
      }
    }
    stage('Test') {
      steps {
        script {
          docker.image("${IMAGE_NAME}").inside {
            sh 'npm test'
          }
        }
      }
    }
    stage('Report') {
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          junit 'coverage/junit.xml'
        }
      }
    }
  }
}
