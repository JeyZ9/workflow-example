pipeline {
  agent { 
    docker {
       image 'node:22-alpine' 
    } 
  }
  stages {
    stage('Install') {
      steps {
        sh 'npm install'
      }
    }
    stage('Run') {
      steps {
        sh 'npm run dev'
      }
    }
    stage('Test') {
      steps {
        sh 'npm test'
      }
    }
    stage('Report') {
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          junit 'coverage/junit.xml'
        }
      }
    }
  }
}
